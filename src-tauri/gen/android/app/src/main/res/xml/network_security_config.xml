<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is refused everywhere except the loopback address, where the app
     serves its own video files to its own WebView (see video_server.rs). Nothing
     here lets the app reach another machine. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
