<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Android 12+ draws its own splash first. Without these items it shows
         the bitmap launcher icon, which looks blurred next to the vector mark
         of the window background that follows. -->
    <style name="Theme.cullant" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/cullant_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
