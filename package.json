{
  "name": "cullant",
  "version": "0.11.1",
  "description": "Fast, keyboard-first photo culling for Windows",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/version.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "tauri:debug": "tauri dev --config src-tauri/tauri.debug.conf.json",
    "fixtures": "node fixtures/fetch.mjs",
    "version:set": "node scripts/version.mjs"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@lucide/svelte": "^1.23.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "mediabunny": "^1.52.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
